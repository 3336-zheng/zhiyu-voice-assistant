# 应用配置
APP_NAME=智语端侧智能语音笔记助手
APP_VERSION=1.0.0
DEBUG=False
HOST=127.0.0.1
PORT=8337

# 数据库配置
DATABASE_URL=sqlite:///data/database/notes.db

# 模型配置。本地模式填写模型路径；在线模式使用下方兼容端点。
# 本地运行示例：WHISPER_MODEL_PATH=C:/models/whisper-small
# Docker 运行时会自动映射到容器内 /app/models/ 目录，无需修改
WHISPER_MODEL_PATH=./models/whisper-small
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=./models/BGE
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
# 0 表示使用模型默认维度；在线切换模型或维度后需要重建索引
EMBEDDING_DIMENSIONS=0
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
RERANKER_PROVIDER=local
RERANKER_MODEL_PATH=./models/BGE-reranker-v2-m3
RERANKER_API_KEY=
# 在线模式设置 RERANKER_PROVIDER=rerank_compatible；地址必须包含完整 /v1/rerank 路径
RERANKER_API_URL=https://ai-gateway.vercel.sh/v1/rerank
RERANKER_MODEL=cohere/rerank-v3.5
RERANKER_TIMEOUT_SECONDS=30

# 文件存储配置
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.ogg,.webm

# ChromaDB 向量数据库配置
CHROMA_PERSIST_PATH=data/database/chromadb
CHROMA_COLLECTION_NAME=notes

# 混合检索配置
RRF_K=60.0
RRF_TOP_K=10
BM25_TOP_K=20
EMBEDDING_TOP_K=20

# RAG v2（关闭 RAG_V2_ENABLED 可回退到原逐查询链路）
RAG_V2_ENABLED=true
RAG_PARENT_CHILD_ENABLED=true
RAG_CHILD_CHUNK_CHARS=360
RAG_CHILD_CHUNK_OVERLAP_CHARS=60
RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_FINAL_TOP_K=8

# Agent 配置
AGENT_MAX_ITERATIONS=5
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_EVENT_BUFFER_SIZE=2000
AGENT_RUN_RETENTION_SECONDS=3600
AGENT_TOOL_CONTEXT_TOKEN_BUDGET=4000
AGENT_PLAN_MAX_STEPS=6
AGENT_MAX_REPLANS=1

# ASR 引擎配置（whisper=本地, dashscope=百炼API）
ASR_PROVIDER=whisper

# 百炼 DashScope ASR 配置
DASHSCOPE_ASR_API_KEY=your_dashscope_api_key_here
DASHSCOPE_ASR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2

# LLM 配置（OpenAI 兼容接口）
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
SYNC_LEGACY_DOCS_ON_STARTUP=false
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW_TOKENS=16000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60

# 备用模型仅在连接/超时/429/5xx 且流尚未开始时启用
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_URL=
LLM_FALLBACK_MODEL=

# 每百万 Token 单价，用于本地估算成本；不配置则成本显示为 0
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_FALLBACK_INPUT_COST_PER_MILLION=0
LLM_FALLBACK_OUTPUT_COST_PER_MILLION=0

# MCP 外部研究（默认关闭）。仅配置可信的 stdio MCP Server。
MCP_RESEARCH_ENABLED=false
MCP_SERVER_LABEL=external-research
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS_JSON=[]
MCP_SERVER_ENV_JSON={}
MCP_SEARCH_TOOL=web_search
MCP_FETCH_TOOL=fetch_page
MCP_SEARCH_QUERY_ARG=query
MCP_SEARCH_LIMIT_ARG=count
MCP_FETCH_URL_ARG=url
MCP_MAX_QUERIES=2
MCP_MAX_SOURCES=5
MCP_MAX_CONTENT_CHARS=12000
MCP_TIMEOUT_SECONDS=30
MCP_TOTAL_TIMEOUT_SECONDS=90

# 对话记忆配置
MEMORY_MAX_HISTORY=20
MEMORY_SUMMARY_THRESHOLD=10
MEMORY_CONTEXT_TOKEN_BUDGET=3000
MEMORY_SUMMARY_TOKEN_BUDGET=600
MEMORY_SUMMARY_TRIGGER_TOKENS=4000
MEMORY_SUMMARY_INPUT_TOKEN_BUDGET=6000

# 会话过期清理配置
SESSION_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log

# 性能配置
MAX_CONCURRENT_REQUESTS=10
TIMEOUT_SECONDS=300

# Langfuse 可观测配置（可选，不配置则不启用）
# 需要先部署 Langfuse 服务（docker-compose.yml 已包含）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here

# 请求时间线默认开启，正文默认不进入观测平台
OBSERVABILITY_ENABLED=true
OBSERVABILITY_CAPTURE_CONTENT=false

# OpenTelemetry（可选）
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zhiyu-wiki
OTEL_EXPORTER_ENDPOINT=
