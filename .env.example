# 应用配置
APP_NAME=智语端侧智能语音笔记助手
APP_VERSION=1.0.0
DEBUG=False
HOST=127.0.0.1
# 应用对外的 HTTP 端口。本地直接跑 python main.py 时它就是 API 自己的监听端口；
# 走 docker compose 时它是 nginx 反代层的入口端口，请求由 nginx 分发给各个 API 副本
# （API 容器本身不再对外暴露端口，否则 --scale 会因为端口占用起不来第二个副本）。
PORT=8337

# ===== 地址视角说明 =====
# 本文件中的服务地址一律写宿主机视角（127.0.0.1 + 映射端口），供本地直接运行 python main.py 使用。
# 应用跑在容器里时，docker-compose.yml 的 environment 段会把这些地址覆盖为
# compose 内网服务名（mysql / redis / chroma），无需在此改动。
# 映射端口刻意避开了常用值，因为本机可能已有其他项目占用 3306 / 6379 / 8000。

# 数据库配置
# 地址是宿主机视角，供本地直接运行应用时使用（3316 是 compose 映射出来的端口）。
# 容器内的 zhiyu 服务由 docker-compose.yml 覆盖为 mysql:3306，不走这一行。
# 密码要与下方 MYSQL_PASSWORD 填成同一个值。
DATABASE_URL=mysql+pymysql://zhiyu:你的密码@127.0.0.1:3316/zhiyu?charset=utf8mb4
# 单元测试用 SQLite（conftest 自行指定内存库），不需要改这里。
# 想退回 SQLite 跑整个应用时换成下面这行：
# DATABASE_URL=sqlite:///data/database/notes.db

# MySQL 容器凭据（docker compose 建库用，退回 SQLite 时也必须填写）
# 应用本身不读取这四项，但 Settings 里仍声明了它们：
# pydantic-settings 默认 extra="forbid"，.env 中出现未声明的变量会导致启动失败
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=zhiyu
MYSQL_USER=zhiyu
MYSQL_PASSWORD=

# 连接池配置（仅 MySQL 等网络数据库生效，SQLite 路径忽略）
# 单实例上限为 DB_POOL_SIZE + DB_MAX_OVERFLOW = 30 条连接；
# MySQL max-connections 设为 300，可支撑 Stage 7 的 5 个实例并留一倍余量。
# DB_POOL_RECYCLE 必须小于 MySQL 的 wait_timeout（实测为 28800 秒）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis 配置（任务队列、事件流、取消信号、分布式锁，Stage 3 起启用）
REDIS_URL=redis://127.0.0.1:6382/0

# 模型配置。本地模式填写模型路径；在线模式使用下方兼容端点。
# Docker 运行时会自动映射到容器内 /app/models/ 目录，无需修改
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=./models/BGE
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
# 0 表示使用模型默认维度；在线切换模型或维度后需要重建索引
EMBEDDING_DIMENSIONS=0
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
RERANKER_PROVIDER=local
RERANKER_MODEL_PATH=./models/BGE-reranker-v2-m3
RERANKER_API_KEY=
# 在线模式设置 RERANKER_PROVIDER=rerank_compatible；地址必须包含完整 /v1/rerank 路径
RERANKER_API_URL=https://ai-gateway.vercel.sh/v1/rerank
RERANKER_MODEL=cohere/rerank-v4-fast
RERANKER_TIMEOUT_SECONDS=30

# 文件存储配置
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.ogg,.webm

# ChromaDB 向量数据库配置
# embedded 模式下 Chroma 作为库运行在应用进程内，直接读写 CHROMA_PERSIST_PATH；
# server 模式下连接独立的 Chroma 容器，多实例部署必须使用 server 模式
CHROMA_MODE=embedded
CHROMA_PERSIST_PATH=data/database/chromadb
CHROMA_COLLECTION_NAME=notes
# 仅 CHROMA_MODE=server 时生效
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
# 本机开着系统级代理（Clash 等）时，server 模式必须设这一项，否则应用连不上向量库。
# 原因：chromadb 内部用 httpx，httpx 默认 trust_env=True，在 macOS 上会去读系统
# 网络偏好里的代理设置，于是连本机容器的请求也被送进代理，返回 502。
# 这个坑的迷惑之处在于 curl 不读系统代理设置，所以会出现「curl 能通、应用连不上」。
# NO_PROXY=127.0.0.1,localhost,chroma

# 混合检索配置
RRF_K=60.0
RRF_TOP_K=30
BM25_TOP_K=20
EMBEDDING_TOP_K=20

# RAG v2（关闭 RAG_V2_ENABLED 可回退到原逐查询链路）
RAG_V2_ENABLED=true
RAG_PARENT_CHILD_ENABLED=true
RAG_PARENT_CHUNK_CHARS=1200
RAG_PARENT_CHUNK_OVERLAP_CHARS=120
RAG_CHILD_CHUNK_CHARS=500
RAG_CHILD_CHUNK_OVERLAP_CHARS=80
RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_FINAL_TOP_K=5

# Agent 配置
AGENT_MAX_ITERATIONS=5
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_EVENT_BUFFER_SIZE=2000
AGENT_RUN_RETENTION_SECONDS=3600
AGENT_TOOL_CONTEXT_TOKEN_BUDGET=4000
AGENT_PLAN_MAX_STEPS=6
AGENT_MAX_REPLANS=1

# ASR 引擎配置（dashscope=百炼 API, mimo=小米 MiMo）
# 本地 whisper 已移除：语音识别统一走远程模型
ASR_PROVIDER=dashscope
ASR_TIMEOUT_SECONDS=180
AUDIO_NORMALIZE_TIMEOUT_SECONDS=120
AUDIO_PROBE_TIMEOUT_SECONDS=15

# 百炼 DashScope ASR 配置
DASHSCOPE_ASR_API_KEY=your_dashscope_api_key_here
DASHSCOPE_ASR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2

# 小米 MiMo ASR（OpenAI 兼容 Chat Completions，音频 Base64 上限 10 MB）
# tp- 开头的 Token Plan Key 必须改为套餐页面提供的专属 Base URL；sk- Key 使用公共地址。
MIMO_ASR_API_KEY=
MIMO_ASR_API_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_REQUEST_TIMEOUT_SECONDS=120
MIMO_ASR_MAX_BASE64_BYTES=10485760

# arq 任务队列（索引任务由 arq-worker 消费，转写由 arq-worker-asr 消费）
ARQ_INDEX_QUEUE=arq:index
ARQ_INDEX_MAX_JOBS=10
ARQ_JOB_TIMEOUT_SECONDS=300
# ASR 队列。转写是远程调用，并发上限交给供应商侧；调大前先确认对方限流
ARQ_ASR_QUEUE=arq:asr
ARQ_ASR_MAX_JOBS=4
# Agent 运行队列。与索引、转写分开：一次运行可能跑满 180 秒，
# 而且是交互式任务，不该排在后台批处理后面
ARQ_AGENT_QUEUE=arq:agent
ARQ_AGENT_MAX_JOBS=4

# Wiki 索引任务
# 兜底扫描一次最多补投多少条——正常路径下任务在写入后立即投递，
# 这里只管漏网的，不需要取很多
WIKI_INDEX_SWEEP_LIMIT=100
# 失败重试的最大退避秒数；退避时间记录在 wiki_index_tasks.next_attempt_at 上
WIKI_INDEX_MAX_BACKOFF_SECONDS=300
# 超过这个秒数还停在 processing 的任务视为 worker 已崩溃，回收重跑。
# 必须大于 ARQ_JOB_TIMEOUT_SECONDS，否则正在执行的长任务会被误判成卡死
WIKI_INDEX_STALE_SECONDS=600

# LLM 配置（Vercel AI Gateway 的 OpenAI 兼容 Chat Completions 接口）
LLM_API_KEY=your_vercel_ai_gateway_key
LLM_API_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=deepseek/deepseek-v4-flash
SYNC_LEGACY_DOCS_ON_STARTUP=false
# Vercel AI Gateway 分阶段模型；空值时回退到 LLM_MODEL
LLM_PLANNER_MODEL=openai/gpt-4.1-mini
LLM_QUERY_REWRITE_MODEL=openai/gpt-4.1-nano
LLM_CRAG_MODEL=openai/gpt-4.1-mini
LLM_RESPONDER_MODEL=openai/gpt-4.1-mini
LLM_MAX_TOKENS=1024
LLM_RESPONSE_MAX_TOKENS=1024
LLM_CONTEXT_WINDOW_TOKENS=16000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_RESPONSE_FORMAT_MODE=disabled
# auto：Function Calling 优先，网关不兼容时回退到 JSON
LLM_STRUCTURED_OUTPUT_MODE=auto

# RAG v2 性能配置
RAG_RERANK_CANDIDATE_TOP_K=12
RETRIEVAL_RERANK_MIN_SCORE=0.35
RETRIEVAL_RERANK_SCORE_MARGIN=0.20
RETRIEVAL_MAX_WORKERS=8
FAST_PATH_ENABLED=true
FAST_PATH_RERANK_MIN_SCORE=0.75
FAST_PATH_MIN_SOURCES=1
QUERY_EMBEDDING_CACHE_TTL_SECONDS=60
QUERY_REWRITE_CACHE_TTL_SECONDS=300
QUERY_REWRITE_CACHE_MAX_ENTRIES=256
RETRIEVAL_CACHE_TTL_SECONDS=20
CRAG_CACHE_TTL_SECONDS=60

# 备用模型仅在连接/超时/429/5xx 且流尚未开始时启用
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_URL=
LLM_FALLBACK_MODEL=

# 每百万 Token 单价，用于本地估算成本；不配置则成本显示为 0
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_FALLBACK_INPUT_COST_PER_MILLION=0
LLM_FALLBACK_OUTPUT_COST_PER_MILLION=0

# CRAG 证据相关性双阈值：最高有效 evidence score 的三段分类边界
CRAG_UPPER_THRESHOLD=0.7
CRAG_LOWER_THRESHOLD=0.3
CRAG_RECOVERY_MIN_SCORE=0.1

# MCP 外部研究（默认关闭）。仅配置可信的 stdio MCP Server。
MCP_RESEARCH_ENABLED=false
MCP_SERVER_LABEL=external-research
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS_JSON=[]
MCP_SERVER_ENV_JSON={}
MCP_SEARCH_TOOL=web_search
MCP_FETCH_TOOL=fetch_page
MCP_SEARCH_QUERY_ARG=query
MCP_SEARCH_LIMIT_ARG=count
MCP_FETCH_URL_ARG=url
MCP_MAX_QUERIES=2
MCP_MAX_SOURCES=5
MCP_MAX_CONTENT_CHARS=12000
MCP_TIMEOUT_SECONDS=30
MCP_TOTAL_TIMEOUT_SECONDS=90

# 对话记忆配置
MEMORY_MAX_HISTORY=20
MEMORY_SUMMARY_THRESHOLD=10
MEMORY_CONTEXT_TOKEN_BUDGET=3000
MEMORY_SUMMARY_TOKEN_BUDGET=600
MEMORY_SUMMARY_TRIGGER_TOKENS=4000
MEMORY_SUMMARY_INPUT_TOKEN_BUDGET=6000

# 会话过期清理配置
SESSION_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log
LOG_ERROR_FILE=data/logs/error.log
# 单个日志文件 10 MB，轮转后保留 7 个备份；两类日志合计上限约 160 MB
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7

# 性能配置
MAX_CONCURRENT_REQUESTS=10
TIMEOUT_SECONDS=300

# Langfuse 可观测配置（可选，不配置则不启用）
# 需要先部署 Langfuse 服务（docker-compose.yml 已包含）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here

# 请求时间线默认开启，正文默认不进入观测平台
OBSERVABILITY_ENABLED=true
OBSERVABILITY_CAPTURE_CONTENT=false
# 追踪查询默认只允许本机访问；远程部署需先补充鉴权再开启远程访问
OBSERVABILITY_TRACE_API_ENABLED=true
OBSERVABILITY_TRACE_ALLOW_REMOTE=false

# OpenTelemetry（可选）
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zhiyu-wiki
OTEL_EXPORTER_ENDPOINT=
